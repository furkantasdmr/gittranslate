<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- GitHub'dan repo bilgisi almak ve dil paketlerini indirmek için -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Bazı telefonlar (Xiaomi, Huawei, Samsung…) arka plandaki servisi kapatmasın diye -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Uygulama içinden güncelleme (yeni sürümü kendisi kurar) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- "GitHub'ı aç" düğmesi için (Android 11+) -->
    <queries>
        <package android:name="com.github.android" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- GitHub uygulamasında Paylaş → "Repoyu anlat" -->
        <activity
            android:name=".RepoActivity"
            android:exported="true"
            android:label="@string/share_label"
            android:theme="@style/PanelTheme"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- GitHub açıkken sağdaki 📖 balonu -->
        <service
            android:name=".BalonServisi"
            android:exported="true"
            android:label="@string/service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/balon_servisi" />
        </service>

        <receiver android:name=".GuncellemeAlici" android:exported="false" />
    </application>
</manifest>
