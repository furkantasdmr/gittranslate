<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- GitHub'dan repo bilgisi almak ve dil paketlerini indirmek için -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- "GitHub'ı aç" düğmesi için (Android 11+) -->
    <queries>
        <package android:name="com.github.android" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:roundIcon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- GitHub uygulamasında Paylaş → "Repoyu anlat" -->
        <activity
            android:name=".RepoActivity"
            android:exported="true"
            android:label="@string/share_label"
            android:theme="@style/PanelTheme"
            android:launchMode="singleTop"
            android:excludeFromRecents="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>
</manifest>
